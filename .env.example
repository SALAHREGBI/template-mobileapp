# Copy to `.env` and fill in values. Never commit real production secrets.

# --- Expo (see also frontend/mobile-app/docker-entrypoint.sh) ------------
# Required when the Metro/Expo service runs in Docker: set to this machine's Wi‑Fi IPv4 (e.g. ipconfig on Windows)
# so Expo Go on your phone loads the bundle from the PC, not an unreachable container address.
LAN_HOST=192.168.1.50

# Leave unset for LAN dev: the app derives http://<host from Expo>:8080 from hostUri (Metro port → Spring on 8080).
# Set for production/EAS or fixed API URL; if set, this overrides automatic resolution.
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com

# If Expo Go cannot reach Metro (firewall / guest Wi‑Fi), set to 1 to use Expo’s tunnel (slower, needs Expo account for some flows):
# EXPO_TUNNEL=1

# --- PostgreSQL (must match SPRING_DATASOURCE_* for backend) -------------
POSTGRES_PASSWORD=change-this-postgres-password

# --- Redis ----------------------------------------------------------------
REDIS_PASSWORD=change-this-redis-password

# --- JWT signing (minimum 32 UTF-8 bytes; rotate per environment) ---------
DABA_JWT_SECRET=dev-change-me-opensslRandBase6448-min-32-utf8-characters-required-value
DABA_JWT_ISSUER=daba-api
DABA_JWT_ACCESS_TTL=P1D
